# Copy to .env.local for development.

# Where the backend's tRPC API is served (default: /api on the same host).
# VITE_API_URL=http://localhost:3001

# "Continue with Google": the OAuth web client id from Google Cloud — the same value as the
# backend's GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
